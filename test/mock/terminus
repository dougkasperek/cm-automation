#!/usr/bin/env bash
#
# test/mock/terminus
# A fake `terminus` binary for offline testing. Put test/mock first on PATH and
# the healthcheck script runs end to end with no Pantheon account, no network,
# and no SSH key.
#
# It deliberately reproduces the failure modes that were hit against the REAL
# fleet, so a fix can be proven before it goes near production:
#
#   normalsite          happy path, healthy
#   staleback           DB backup 10 days old            -> CRIT
#   coredrift           WP core update available         -> CRIT
#   plugindrift         3 plugin updates + upstream      -> WARN
#   frozensite          frozen:true                      -> FROZEN
#   pfannenbergpartners live env exists but UNINITIALIZED -> SKIP, and it HANGS
#                       if anything actually tries remote:wp against it
#   noisysite           emits SSH host-key + Terminus notice noise on stdout
#   ghostenv            has no live env at all            -> SKIP
#   timeoutsite         env:list itself hangs             -> ERROR (not SKIP)
#   drupalsite          non-WordPress, WP checks not applicable
#
set -u

CMD="${1:-}"
shift || true

# The real thing, trimmed, from galbanicheese.live on 2026-08-23. Pantheon's
# own wp-native-php-sessions mu-plugin emits these on PHP 8.2, on STDOUT,
# before WP-CLI's JSON. The call exits 0 and the JSON is intact behind them.
# strip_noise did not cover these lines, so json_or_empty refused the whole
# response and the scanner recorded plugin_updates=0 on a site with 15.
emit_php_notices() {
  echo "PHP Deprecated:  Return type of Pantheon_Sessions\Session_Handler::open(\$save_path, \$session_name) should either be compatible with SessionHandlerInterface::open(string \$path, string \$name): bool, or the #[\ReturnTypeWillChange] attribute should be used to temporarily suppress the notice in /code/wp-content/mu-plugins/wp-native-php-sessions/inc/class-session-handler.php on line 26"
  echo "Deprecated: Return type of Pantheon_Sessions\Session_Handler::close() should either be compatible with SessionHandlerInterface::close(): bool, or the #[\ReturnTypeWillChange] attribute should be used to temporarily suppress the notice in /code/wp-content/mu-plugins/wp-native-php-sessions/inc/class-session-handler.php on line 117"
  echo "PHP Notice:  Undefined index: x in /code/wp-content/mu-plugins/z.php on line 9"
  # morrison-chs, 2026-08-23. A bare `Warning:` from WP-CLI itself, which the
  # first pass of PHP-notice patterns did not cover -- so that site alone kept
  # reading unknown after the others were fixed.
  echo "Warning: Constant DISALLOW_FILE_MODS already defined in phar:///opt/pantheon/wpcli/wp-cli.phar/vendor/wp-cli/wp-cli/php/WP_CLI/Runner.php(1334) : eval"
  # And one nobody has ever seen, to prove the fallback in json_or_empty picks
  # up the payload without anyone adding a pattern for it first.
  echo "some unpredicted preamble nobody wrote a filter for"
}

emit_noise() {
  echo "Warning: Permanently added 'appserver.live.abc123.drush.in' to the list of known hosts."
  echo "[notice] Command: appserver.live.abc123 -- wp plugin list"
  echo " [0.42 s] Loaded configuration"
}

case "$CMD" in
  auth:whoami)
    # The mock now MODELS A SESSION rather than only a boolean, because the
    # real failure of 2026-08-18 lived in the gap between "auth:login exited 0"
    # and "a session now exists". pantheon_login verifies the second, so the
    # mock has to be able to represent it.
    if [ "${MOCK_LOGGED_IN:-0}" = "1" ]; then echo "ci@clevermethod.com"; exit 0; fi
    if [ -n "${MOCK_SESSION_FILE:-}" ] && [ -s "${MOCK_SESSION_FILE:-}" ]; then
      cat "$MOCK_SESSION_FILE"; exit 0
    fi
    # MOCK_WHOAMI_SILENT_OK reproduces the REAL behaviour observed on a GitHub
    # runner on 2026-08-18: no session, no output, and exit 0 anyway. Any
    # caller that reads the exit code instead of the identity concludes it is
    # logged in, skips the machine-token login, and then gets an empty fleet.
    if [ "${MOCK_WHOAMI_SILENT_OK:-0}" = "1" ]; then exit 0; fi
    exit 1
    ;;

  auth:login)
    case "${1:-}" in
      --machine-token=*)
        tok="${1#--machine-token=}"
        if [ "$tok" = "BAD" ] || [ -z "$tok" ]; then
          echo "[error] Invalid machine token." >&2; exit 1
        fi
        if [ -n "${MOCK_SESSION_FILE:-}" ]; then
          echo "ci@clevermethod.com" > "$MOCK_SESSION_FILE"
        fi
        echo "Logged in via machine token."; exit 0 ;;
      *) echo "[error] no machine token" >&2; exit 1 ;;
    esac
    ;;

  site:list)
    # An unauthenticated site:list returns an empty array, exactly as Pantheon
    # does. Before 2026-08-18 this mock returned the whole fleet regardless,
    # which is why an offline suite of 19 assertions could pass while the real
    # CI job had never once authenticated.
    if [ "${MOCK_LOGGED_IN:-0}" != "1" ] \
       && { [ -z "${MOCK_SESSION_FILE:-}" ] || [ ! -s "${MOCK_SESSION_FILE:-}" ]; }; then
      echo "[]"; exit 0
    fi
    cat <<'JSON'
[
 {"name":"normalsite","framework":"wordpress","plan_name":"Performance Small","frozen":false},
 {"name":"staleback","framework":"wordpress","plan_name":"Basic","frozen":false},
 {"name":"coredrift","framework":"wordpress","plan_name":"Performance Medium","frozen":false},
 {"name":"plugindrift","framework":"wordpress","plan_name":"Basic","frozen":false},
 {"name":"frozensite","framework":"wordpress","plan_name":"Sandbox","frozen":true},
 {"name":"pfannenbergpartners","framework":"wordpress","plan_name":"Sandbox","frozen":false},
 {"name":"noisysite","framework":"wordpress","plan_name":"Basic","frozen":false},
 {"name":"noticysite","framework":"wordpress","plan_name":"Basic","frozen":false},
 {"name":"dbmissing","framework":"wordpress","plan_name":"Sandbox","frozen":false},
 {"name":"ghostenv","framework":"wordpress","plan_name":"Sandbox","frozen":false},
 {"name":"timeoutsite","framework":"wordpress","plan_name":"Basic","frozen":false},
 {"name":"drupalsite","framework":"drupal9","plan_name":"Performance Small","frozen":false}
]
JSON
    exit 0
    ;;

  env:list)
    site="${1:-}"
    case "$site" in
      timeoutsite) sleep 600; exit 0 ;;   # hangs; must be caught by the timeout
      ghostenv)    echo '{"dev":{"id":"dev","initialized":"true"}}'; exit 0 ;;
      pfannenbergpartners)
        echo '{"dev":{"id":"dev","initialized":"true"},"test":{"id":"test","initialized":"false"},"live":{"id":"live","initialized":"false"}}'
        exit 0 ;;
      noisysite)
        emit_noise
        echo '{"dev":{"id":"dev","initialized":"true"},"live":{"id":"live","initialized":"true"}}'
        exit 0 ;;
      *)
        echo '{"dev":{"id":"dev","initialized":"true"},"test":{"id":"test","initialized":"true"},"live":{"id":"live","initialized":"true"}}'
        exit 0 ;;
    esac
    ;;

  env:info)
    se="${1:-}"
    case "$se" in
      noisysite.*) emit_noise; echo "8.1" ;;
      staleback.*) echo "7.4" ;;
      *)           echo "8.2" ;;
    esac
    exit 0
    ;;

  backup:list)
    se="${1:-}"
    now="$(date +%s)"
    case "$se" in
      staleback.*)  echo "[{\"date\":$((now - 10*86400))}]" ;;
      coredrift.*)  echo "[{\"date\":$((now - 3600))}]" ;;
      noisysite.*)  emit_noise; echo "[{\"date\":$((now - 7200)).5}]" ;;   # float timestamp on purpose
      ghostenv.*)   echo "[]" ;;
      *)            echo "[{\"date\":$((now - 43200))},{\"date\":$((now - 90000))}]" ;;
    esac
    exit 0
    ;;

  site:upstream:clear-cache) exit 0 ;;

  upstream:updates:list)
    se="${1:-}"
    case "$se" in
      plugindrift.*) echo '[{"hash":"a1"},{"hash":"b2"}]' ;;
      *)             echo '[]' ;;
    esac
    exit 0
    ;;

  remote:wp)
    # DRAIN STDIN, because the real thing does.
    #
    # `terminus remote:wp` spawns ssh, and ssh reads stdin. Any caller that
    # feeds a loop from stdin has the rest of its input eaten on the first
    # site. This mock did not read stdin, so a full-mode scan of ten sites
    # passed here while every real full-mode scan - laptop and CI alike -
    # silently stopped after ONE site and reported the requested count.
    # A mock that is politer than production certifies bugs as fixed.
    # ...but only when stdin is not a terminal. Draining a TTY blocks forever,
    # so running this mock by hand from an interactive shell would hang on
    # every call. The harness sets stdin to /dev/null so the drain still runs
    # there and the regression stays covered.
    [ -t 0 ] || cat >/dev/null 2>&1 || true
    se="${1:-}"
    # If the env preflight is working, this must NEVER be reached for
    # pfannenbergpartners. If it is, the run will hang - which is exactly the
    # production bug, reproduced here so a regression cannot pass silently.
    case "$se" in
      pfannenbergpartners.*) sleep 600; exit 0 ;;
    esac
    # THE THREE WAYS A WP-CLI CALL FAILS WHILE THE SCANNER RECORDS A CLEAN
    # VALUE. Item 22. None of these existed here, so the offline suite could
    # only ever exercise calls that SUCCEED -- and the whole question is what
    # happens when one does not. A mock that can only succeed cannot test a
    # tool whose job is detecting failure.
    #
    # Deliberately NOT added to site:list: these are reached by naming them
    # directly, so no fleet count anywhere moves. run-local-test.sh is
    # untouched by their existence.
    case "$se" in
      # 1. exits non-zero, and the reason is on stderr -- which
      #    run_with_timeout sends to /dev/null, so the scanner never sees it.
      wpclifail.*)
        echo "Error: Could not establish a connection to the remote host." >&2
        exit 1 ;;
      # 2. exits ZERO and prints a non-JSON error on stdout. json_or_empty
      #    rejects it, the scanner's `|| x=""` fires, and the else branch
      #    writes the clean value. The nastiest of the three: everything about
      #    it looks like success.
      wpclijunk.*)
        echo "Error: This does not seem to be a WordPress installation."
        exit 0 ;;
      # 3. hangs. run_capture returns 124, as run_with_timeout does.
      wpclihang.*) sleep 600; exit 0 ;;
      # 4. NOT a failure mode of the fleet at all: a name that is not a
      #    Pantheon site. Real text from 2026-08-23, when the domain was
      #    passed where the Pantheon site name was wanted. It must never be
      #    scored in the same column as a fabricated measurement.
      notasite.*)
        echo "[error]  Could not locate a site your user may access identified by notasite: A site named notasite was not found." >&2
        exit 1 ;;
    esac
    # `core check-update` and `core version` are BOTH `core`, and they answer
    # different questions in different formats: check-update returns JSON about
    # the version AVAILABLE, version returns bare text for the version
    # INSTALLED. Keying only on the noun made them indistinguishable, which is
    # how a scan reporting "up-to-date" on every site looked like an answer.
    sub=""; verb=""; mustuse=""
    for a in "$@"; do
      case "$a" in
        core|plugin|theme) [ -z "$sub" ] && sub="$a" ;;
        version|check-update|list) [ -n "$sub" ] && [ -z "$verb" ] && verb="$a" ;;
        # `plugin list` OMITS must-use plugins unless asked, so the scanner
        # makes a second call for them. A mock that answered both calls
        # identically would report Pantheon's mu-plugins as ordinary ones and
        # hide the fact that the second call is even made.
        --status=must-use) mustuse="1" ;;
      esac
    done
    # Sub-key so must-use can be matched separately from the regular list.
    [ -n "$mustuse" ] && sub="muplugin"
    case "$se" in
      noisysite.*)  emit_noise ;;
      noticysite.*) emit_php_notices ;;
    esac
    case "$se:$sub:$verb" in
      # ORDER IS LOAD-BEARING HERE. `case` takes the FIRST match, so every
      # site-specific pattern must sit above the `*:core:version` catch-all
      # below. These two were originally added underneath it and were dead --
      # dbmissing answered 7.0.2 like everything else, and the run-local
      # assertion caught it. Same shape as the note further down about `core
      # version` and `core check-update` both being "core".
      # cm-whitelabel, reproduced. `core version` reads the version off DISK
      # and needs no database, so it answers 6.9.4 and looks like a healthy
      # measurement; every call that needs the database exits 1. That split is
      # what proved the SSH session was fine and the site was not, and it is
      # why `core version` is the control call in diagnose-wp-calls.sh.
      dbmissing.*:core:version) echo "6.9.4" ;;
      dbmissing.*)
        echo "Error: The site you have requested is not installed."
        echo "Run \`wp core install\` to create database tables."
        exit 1 ;;
      noticysite.*:core:version)      echo "7.0.3" ;;
      noticysite.*:core:check-update) echo '[{"version":"7.1","update_type":"major"}]' ;;
      # 20 plugins installed, 15 of them with an update pending. The count the
      # scanner records must be 15, and it is now DERIVED by selecting
      # update=="available" rather than taking the array length. The five
      # up-to-date entries exist so that a regression back to `jq length`
      # reports 20 and fails the assertion instead of passing silently.
      noticysite.*:plugin:*) echo '[{"name":"a","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"b","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"c","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"d","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"e","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"f","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"g","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"h","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"i","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"j","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"k","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"l","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"m","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"n","status":"inactive","update":"available","version":"1.0","update_version":"1.1"},{"name":"o","status":"active","update":"available","version":"1.0","update_version":"1.1"},{"name":"settled-1","status":"active","update":"none","version":"2.0","update_version":""},{"name":"settled-2","status":"active","update":"none","version":"2.0","update_version":""},{"name":"settled-3","status":"inactive","update":"none","version":"2.0","update_version":""},{"name":"settled-4","status":"active","update":"none","version":"2.0","update_version":""},{"name":"settled-5","status":"active","update":"none","version":"2.0","update_version":""}]' ;;
      # 5 themes installed, 3 pending. Same reason as above.
      noticysite.*:theme:*)  echo '[{"name":"t1","status":"active","update":"available","version":"1.0","update_version":"1.2"},{"name":"t2","status":"inactive","update":"available","version":"1.0","update_version":"1.2"},{"name":"t3","status":"inactive","update":"available","version":"1.0","update_version":"1.2"},{"name":"t4","status":"inactive","update":"none","version":"3.0","update_version":""},{"name":"t5","status":"inactive","update":"none","version":"3.0","update_version":""}]' ;;
      # Installed version. Plain text, never JSON.
      # coredrift sits on an older release than it reports as available.
      coredrift.*:core:version)   echo "6.8.1" ;;
      # noisysite prints the version AFTER the SSH and Terminus noise, so a
      # regression in strip_noise shows up as a version of "0.42" rather than
      # as a crash.
      noisysite.*:core:version)   echo "7.0.2" ;;
      # staleback answers nothing at all. It must read "unknown" - it looked
      # and could not tell - and never "n/a", which means it did not look.
      staleback.*:core:version)   : ;;
      *:core:version)             echo "7.0.2" ;;

      # Version available, JSON. Empty list means none pending.
      coredrift.*:core:check-update) echo '[{"version":"6.9.1","update_type":"major"}]' ;;
      # Behind the notice wall: a core update and a 15-plugin backlog, the
      # shape galbanicheese actually had while the ledger recorded 0 and
      # "up-to-date". If strip_noise regresses, these become 0 again and the
      # assertions in run-local-test.sh fail.
      plugindrift.*:plugin:*) echo '[{"name":"akismet","status":"active","update":"available","version":"5.3","update_version":"5.3.4"},{"name":"wordfence","status":"active","update":"available","version":"7.11.0","update_version":"8.0.2"},{"name":"yoast","status":"active","update":"available","version":"22.4","update_version":"23.1"},{"name":"classic-editor","status":"inactive","update":"none","version":"1.6.5","update_version":""}]' ;;
      *:core:*)   echo '[]' ;;
      # Every WordPress site on Pantheon carries this one, and `plugin list`
      # never shows it. If the scanner stops making the must-use call, these
      # rows vanish from the inventory and nothing else changes -- which is
      # why test-wp-calls.py asserts on them directly.
      *:muplugin:*) echo '[{"name":"wp-native-php-sessions","status":"must-use","version":"2.0.1"},{"name":"pantheon-mu-plugin","status":"must-use","version":"1.4.0"}]' ;;
      *:plugin:*) echo '[{"name":"akismet","status":"active","update":"none","version":"5.3.4","update_version":""},{"name":"classic-editor","status":"inactive","update":"none","version":"1.6.5","update_version":""}]' ;;
      *:theme:*)  echo '[{"name":"twentytwentyfour","status":"active","update":"none","version":"1.3","update_version":""}]' ;;
      *)          echo '[]' ;;
    esac
    exit 0
    ;;

  *)
    echo "[error] mock terminus: unhandled command '$CMD'" >&2
    exit 1
    ;;
esac

#!/usr/bin/env bash
#
# test/mock/terminus
# A fake `terminus` binary for offline testing. Put test/mock first on PATH and
# the healthcheck script runs end to end with no Pantheon account, no network,
# and no SSH key.
#
# It deliberately reproduces the failure modes that were hit against the REAL
# fleet, so a fix can be proven before it goes near production:
#
#   normalsite          happy path, healthy
#   staleback           DB backup 10 days old            -> CRIT
#   coredrift           WP core update available         -> CRIT
#   plugindrift         3 plugin updates + upstream      -> WARN
#   frozensite          frozen:true                      -> FROZEN
#   pfannenbergpartners live env exists but UNINITIALIZED -> SKIP, and it HANGS
#                       if anything actually tries remote:wp against it
#   noisysite           emits SSH host-key + Terminus notice noise on stdout
#   ghostenv            has no live env at all            -> SKIP
#   timeoutsite         env:list itself hangs             -> ERROR (not SKIP)
#   drupalsite          non-WordPress, WP checks not applicable
#
set -u

CMD="${1:-}"
shift || true

emit_noise() {
  echo "Warning: Permanently added 'appserver.live.abc123.drush.in' to the list of known hosts."
  echo "[notice] Command: appserver.live.abc123 -- wp plugin list"
  echo " [0.42 s] Loaded configuration"
}

case "$CMD" in
  auth:whoami)
    # The mock now MODELS A SESSION rather than only a boolean, because the
    # real failure of 2026-08-18 lived in the gap between "auth:login exited 0"
    # and "a session now exists". pantheon_login verifies the second, so the
    # mock has to be able to represent it.
    if [ "${MOCK_LOGGED_IN:-0}" = "1" ]; then echo "ci@clevermethod.com"; exit 0; fi
    if [ -n "${MOCK_SESSION_FILE:-}" ] && [ -s "${MOCK_SESSION_FILE:-}" ]; then
      cat "$MOCK_SESSION_FILE"; exit 0
    fi
    # MOCK_WHOAMI_SILENT_OK reproduces the REAL behaviour observed on a GitHub
    # runner on 2026-08-18: no session, no output, and exit 0 anyway. Any
    # caller that reads the exit code instead of the identity concludes it is
    # logged in, skips the machine-token login, and then gets an empty fleet.
    if [ "${MOCK_WHOAMI_SILENT_OK:-0}" = "1" ]; then exit 0; fi
    exit 1
    ;;

  auth:login)
    case "${1:-}" in
      --machine-token=*)
        tok="${1#--machine-token=}"
        if [ "$tok" = "BAD" ] || [ -z "$tok" ]; then
          echo "[error] Invalid machine token." >&2; exit 1
        fi
        if [ -n "${MOCK_SESSION_FILE:-}" ]; then
          echo "ci@clevermethod.com" > "$MOCK_SESSION_FILE"
        fi
        echo "Logged in via machine token."; exit 0 ;;
      *) echo "[error] no machine token" >&2; exit 1 ;;
    esac
    ;;

  site:list)
    # An unauthenticated site:list returns an empty array, exactly as Pantheon
    # does. Before 2026-08-18 this mock returned the whole fleet regardless,
    # which is why an offline suite of 19 assertions could pass while the real
    # CI job had never once authenticated.
    if [ "${MOCK_LOGGED_IN:-0}" != "1" ] \
       && { [ -z "${MOCK_SESSION_FILE:-}" ] || [ ! -s "${MOCK_SESSION_FILE:-}" ]; }; then
      echo "[]"; exit 0
    fi
    cat <<'JSON'
[
 {"name":"normalsite","framework":"wordpress","plan_name":"Performance Small","frozen":false},
 {"name":"staleback","framework":"wordpress","plan_name":"Basic","frozen":false},
 {"name":"coredrift","framework":"wordpress","plan_name":"Performance Medium","frozen":false},
 {"name":"plugindrift","framework":"wordpress","plan_name":"Basic","frozen":false},
 {"name":"frozensite","framework":"wordpress","plan_name":"Sandbox","frozen":true},
 {"name":"pfannenbergpartners","framework":"wordpress","plan_name":"Sandbox","frozen":false},
 {"name":"noisysite","framework":"wordpress","plan_name":"Basic","frozen":false},
 {"name":"ghostenv","framework":"wordpress","plan_name":"Sandbox","frozen":false},
 {"name":"timeoutsite","framework":"wordpress","plan_name":"Basic","frozen":false},
 {"name":"drupalsite","framework":"drupal9","plan_name":"Performance Small","frozen":false}
]
JSON
    exit 0
    ;;

  env:list)
    site="${1:-}"
    case "$site" in
      timeoutsite) sleep 600; exit 0 ;;   # hangs; must be caught by the timeout
      ghostenv)    echo '{"dev":{"id":"dev","initialized":"true"}}'; exit 0 ;;
      pfannenbergpartners)
        echo '{"dev":{"id":"dev","initialized":"true"},"test":{"id":"test","initialized":"false"},"live":{"id":"live","initialized":"false"}}'
        exit 0 ;;
      noisysite)
        emit_noise
        echo '{"dev":{"id":"dev","initialized":"true"},"live":{"id":"live","initialized":"true"}}'
        exit 0 ;;
      *)
        echo '{"dev":{"id":"dev","initialized":"true"},"test":{"id":"test","initialized":"true"},"live":{"id":"live","initialized":"true"}}'
        exit 0 ;;
    esac
    ;;

  env:info)
    se="${1:-}"
    case "$se" in
      noisysite.*) emit_noise; echo "8.1" ;;
      staleback.*) echo "7.4" ;;
      *)           echo "8.2" ;;
    esac
    exit 0
    ;;

  backup:list)
    se="${1:-}"
    now="$(date +%s)"
    case "$se" in
      staleback.*)  echo "[{\"date\":$((now - 10*86400))}]" ;;
      coredrift.*)  echo "[{\"date\":$((now - 3600))}]" ;;
      noisysite.*)  emit_noise; echo "[{\"date\":$((now - 7200)).5}]" ;;   # float timestamp on purpose
      ghostenv.*)   echo "[]" ;;
      *)            echo "[{\"date\":$((now - 43200))},{\"date\":$((now - 90000))}]" ;;
    esac
    exit 0
    ;;

  site:upstream:clear-cache) exit 0 ;;

  upstream:updates:list)
    se="${1:-}"
    case "$se" in
      plugindrift.*) echo '[{"hash":"a1"},{"hash":"b2"}]' ;;
      *)             echo '[]' ;;
    esac
    exit 0
    ;;

  remote:wp)
    # DRAIN STDIN, because the real thing does.
    #
    # `terminus remote:wp` spawns ssh, and ssh reads stdin. Any caller that
    # feeds a loop from stdin has the rest of its input eaten on the first
    # site. This mock did not read stdin, so a full-mode scan of ten sites
    # passed here while every real full-mode scan - laptop and CI alike -
    # silently stopped after ONE site and reported the requested count.
    # A mock that is politer than production certifies bugs as fixed.
    cat >/dev/null 2>&1 || true
    se="${1:-}"
    # If the env preflight is working, this must NEVER be reached for
    # pfannenbergpartners. If it is, the run will hang - which is exactly the
    # production bug, reproduced here so a regression cannot pass silently.
    case "$se" in
      pfannenbergpartners.*) sleep 600; exit 0 ;;
    esac
    # `core check-update` and `core version` are BOTH `core`, and they answer
    # different questions in different formats: check-update returns JSON about
    # the version AVAILABLE, version returns bare text for the version
    # INSTALLED. Keying only on the noun made them indistinguishable, which is
    # how a scan reporting "up-to-date" on every site looked like an answer.
    sub=""; verb=""
    for a in "$@"; do
      case "$a" in
        core|plugin|theme) [ -z "$sub" ] && sub="$a" ;;
        version|check-update|list) [ -n "$sub" ] && [ -z "$verb" ] && verb="$a" ;;
      esac
    done
    case "$se" in
      noisysite.*) emit_noise ;;
    esac
    case "$se:$sub:$verb" in
      # Installed version. Plain text, never JSON.
      # coredrift sits on an older release than it reports as available.
      coredrift.*:core:version)   echo "6.8.1" ;;
      # noisysite prints the version AFTER the SSH and Terminus noise, so a
      # regression in strip_noise shows up as a version of "0.42" rather than
      # as a crash.
      noisysite.*:core:version)   echo "7.0.2" ;;
      # staleback answers nothing at all. It must read "unknown" - it looked
      # and could not tell - and never "n/a", which means it did not look.
      staleback.*:core:version)   : ;;
      *:core:version)             echo "7.0.2" ;;

      # Version available, JSON. Empty list means none pending.
      coredrift.*:core:check-update) echo '[{"version":"6.9.1","update_type":"major"}]' ;;
      plugindrift.*:plugin:*) echo '[{"name":"akismet"},{"name":"wordfence"},{"name":"yoast"}]' ;;
      *:core:*)   echo '[]' ;;
      *:plugin:*) echo '[]' ;;
      *:theme:*)  echo '[]' ;;
      *)          echo '[]' ;;
    esac
    exit 0
    ;;

  *)
    echo "[error] mock terminus: unhandled command '$CMD'" >&2
    exit 1
    ;;
esac

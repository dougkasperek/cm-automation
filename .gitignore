# Raw per-run scan output. Regenerable, and once ingested the ledger in
# history/ holds the facts. CI keeps these as build artifacts for 90 days.
reports/

# The ledger is NOT ignored. history/*.jsonl is the append-only record of what
# the fleet looked like over time, and it is the single asset here that cannot
# be regenerated. See docs/DESIGN-REVISIT.md section B.
!history/

*.log
.DS_Store
.terminus/
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Staging area only. The Claude device bridge is not allowed to write into
# .github/, so workflow edits land here first and are copied across. The
# authoritative copy is .github/workflows/. Ignoring this prevents a second,
# silently diverging copy from being committed.

# Wrangler local state and account cache. Created on first `wrangler deploy`.
# Contains an account id and login cache; not a secret, but not shared state.
.wrangler/

# Node. Only the consent sweep needs it: observing what a page requests before
# consent requires running the page, and that means a browser. package.json and
# package-lock.json ARE committed so CI resolves the same versions this ran on.
node_modules/

# Files Claude retired but cannot delete: the device bridge refuses rm, so they
# are moved here and a person clears the folder. Never committed.
_to_delete/

# Wordfence feed cache. 147 MB, rate-limited, never committed.
.feed-cache/
